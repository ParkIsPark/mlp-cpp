{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "windows"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Test (Debug)",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build (Debug)",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
